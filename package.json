{
  "name": "property-platform",
  "private": true,
  "description": "PropertyOS (codename) UI-first prototype: backoffice, customer web/PWA and shared packages",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backoffice,customer -c blue,magenta \"npm:dev:backoffice\" \"npm:dev:customer\"",
    "dev:backoffice": "npm run dev -w @repo/backoffice",
    "dev:customer": "npm run dev -w @repo/customer-web",
    "build": "npm run build -w @repo/backoffice && npm run build -w @repo/customer-web",
    "preview": "concurrently -k -n backoffice,customer \"npm run preview -w @repo/backoffice\" \"npm run preview -w @repo/customer-web\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-logical-css.mjs && node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "evidence": "playwright test --project=evidence",
    "register:sync": "node scripts/sync-screen-register.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
