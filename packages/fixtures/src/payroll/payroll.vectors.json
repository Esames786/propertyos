    { "name": "full period gives the amount exactly", "amount": "55000.00", "counted": 31, "of": 31, "expect": "55000.00" },
    { "name": "joiner on the 15th of October (17 of 31 days)", "amount": "40000.00", "counted": 17, "of": 31, "expect": "21935.48" },
    { "name": "leaver on the 20th of October (20 of 31 days)", "amount": "42000.00", "counted": 20, "of": 31, "expect": "27096.77" },
    { "name": "allowance prorated the same way", "amount": "2000.00", "counted": 20, "of": 31, "expect": "1290.32" },
    { "name": "exactly half a paisa rounds up", "amount": "1000.15", "counted": 15, "of": 30, "expect": "500.08" },
    { "name": "below half a paisa rounds down", "amount": "1000.15", "counted": 1, "of": 30, "expect": "33.34" },
    { "name": "February 2027 (28 days)", "amount": "41000.00", "counted": 14, "of": 28, "expect": "20500.00" },
    { "name": "no days employed", "amount": "41000.00", "counted": 0, "of": 31, "expect": "0.00" },
    { "name": "one paisa over two days rounds up", "amount": "0.01", "counted": 1, "of": 2, "expect": "0.01" }
