    { "name": "bills − credit notes − settled payments, in date order (bills first on a day)", "bills": [{ "id": "b1", "ref": "B-1", "date": "2026-10-01", "state": "approved", "total": "1000.00" }, { "id": "b2", "ref": "B-2", "date": "2026-10-05", "state": "approved", "total": "400.00" }], "creditNotes": [{ "id": "c1", "ref": "CN-1", "date": "2026-10-05", "amount": "100.00" }], "settled": [{ "id": "s1", "ref": "PV-1", "date": "2026-10-03", "amount": "600.00" }], "balance": "700.00", "kinds": ["bill", "settled_payment", "bill", "credit_note"], "running": ["1000.00", "400.00", "800.00", "700.00"] },
    { "name": "a reversed settlement restores the liability", "bills": [{ "id": "b1", "ref": "B-1", "date": "2026-10-01", "state": "approved", "total": "1000.00" }], "creditNotes": [], "settled": [{ "id": "s1", "ref": "PV-1", "date": "2026-10-03", "amount": "1000.00", "reversed": true }], "balance": "1000.00", "kinds": ["bill"], "running": ["1000.00"] },
    { "name": "a reversed credit note restores the liability", "bills": [{ "id": "b1", "ref": "B-1", "date": "2026-10-01", "state": "approved", "total": "1000.00" }], "creditNotes": [{ "id": "c1", "ref": "CN-1", "date": "2026-10-02", "amount": "200.00", "reversed": true }], "settled": [], "balance": "1000.00", "kinds": ["bill"], "running": ["1000.00"] },
    { "name": "paisa are exact (no float)", "bills": [{ "id": "b1", "ref": "B-1", "date": "2026-10-01", "state": "approved", "total": "0.10" }, { "id": "b2", "ref": "B-2", "date": "2026-10-01", "state": "approved", "total": "0.20" }], "creditNotes": [], "settled": [], "balance": "0.30", "kinds": ["bill", "bill"], "running": ["0.10", "0.30"] }
  ],
