    { "name": "an approved bill: its whole total", "bill": { "state": "approved", "lines": ["1240000.00", "0.50"] }, "payments": [], "expected": "1240000.50" },
    { "name": "live instructions (prepared, approved, sent) reduce what may still be instructed", "bill": { "state": "approved", "lines": ["150000.00"] }, "payments": [{ "state": "prepared", "amount": "50000.00" }, { "state": "approved", "amount": "25000.00" }, { "state": "sent_simulated", "amount": "10000.00" }], "expected": "65000.00" },
    { "name": "a cancelled instruction frees its amount", "bill": { "state": "approved", "lines": ["150000.00"] }, "payments": [{ "state": "cancelled", "amount": "150000.00" }], "expected": "150000.00" },
    { "name": "never below zero", "bill": { "state": "approved", "lines": ["100.00"] }, "payments": [{ "state": "prepared", "amount": "150.00" }], "expected": "0.00" }
  ],
  "ledger": [
