      { "action": "send", "from": "prepared", "allowed": false },
      { "action": "send", "from": "sent_simulated", "allowed": false },
      { "action": "cancel", "from": "prepared", "allowed": true },
      { "action": "cancel", "from": "approved", "allowed": true },
      { "action": "cancel", "from": "sent_simulated", "allowed": false, "why": "a sent instruction is withdrawn only by a reversal of its settlement (E-18)" },
      { "action": "cancel", "from": "cancelled", "allowed": false }
    ],
    "expense": [
      { "action": "submit", "from": "draft", "allowed": true },
      { "action": "approve", "from": "submitted", "allowed": true },
      { "action": "approve", "from": "draft", "allowed": false },
      { "action": "reject", "from": "submitted", "allowed": true },
      { "action": "withdraw", "from": "draft", "allowed": true },
      { "action": "withdraw", "from": "submitted", "allowed": true },
      { "action": "withdraw", "from": "approved", "allowed": false }
    ]
  },
  "instructable": [
    { "name": "a draft bill instructs nothing", "bill": { "state": "draft", "lines": ["1000.00"] }, "payments": [], "expected": "0.00" },
