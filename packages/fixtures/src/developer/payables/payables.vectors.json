      { "action": "cancel", "from": "submitted", "allowed": true },
      { "action": "cancel", "from": "rejected", "allowed": true },
      { "action": "cancel", "from": "approved", "allowed": false, "why": "an approved bill is an obligation: corrected only by a credit note (planned)" },
      { "action": "cancel", "from": "cancelled", "allowed": false }
