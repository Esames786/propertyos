      { "action": "submit", "from": "submitted", "allowed": false },
      { "action": "approve", "from": "submitted", "allowed": true },
      { "action": "approve", "from": "draft", "allowed": false },
      { "action": "approve", "from": "approved", "allowed": false },
      { "action": "approve", "from": "rejected", "allowed": false },
      { "action": "reject", "from": "submitted", "allowed": true },
