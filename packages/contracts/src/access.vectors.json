{
  "description": "Access decision vectors (Gate A A1 §4, A6 §2). Each vector patches the base access and states the expected outcome. These become the backend policy tests at Gate H.",
  "base": {
    "tenant": { "id": "tnt_alnoor", "type": "association", "status": "active", "suspensionPolicy": { "allowSettlement": true } },
    "grants": [
      { "module": "core", "sites": "all", "from": "2026-01-01", "source": "preset" },
      { "module": "receivables", "sites": "all", "from": "2026-01-01", "source": "preset" },
      { "module": "dues", "sites": ["site_a"], "from": "2026-01-01", "source": "preset" },
      { "module": "online_payments", "sites": ["site_a"], "from": "2026-12-01", "source": "addon" },
      { "module": "visitors", "sites": "all", "from": "2026-01-01", "to": "2026-11-01", "source": "trial" }
    ],
    "features": ["receivables.office_collections"],
    "permissions": ["invoice.view", "payment.receive", "finance.evidence.review", "residents.view"],
    "scopes": [{ "type": "all" }],
    "userId": "usr_manager"
  },
  "vectors": [
    { "name": "active tenant, granted module, site, permission: allowed", "request": { "module": "dues", "siteId": "site_a", "permission": "invoice.view", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "draft tenant: inactive", "tenant": { "status": "draft" }, "request": { "module": "core", "at": "2026-10-26" }, "expect": "tenant_inactive" },
    { "name": "cancelled tenant: inactive", "tenant": { "status": "cancelled" }, "request": { "module": "core", "suspension": "history_read", "at": "2026-10-26" }, "expect": "tenant_inactive" },
    { "name": "archived tenant: inactive", "tenant": { "status": "archived" }, "request": { "module": "core", "at": "2026-10-26" }, "expect": "tenant_inactive" },
    { "name": "trial tenant: allowed", "tenant": { "status": "trial" }, "request": { "module": "dues", "siteId": "site_a", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "grace tenant: operational action still allowed", "tenant": { "status": "grace" }, "request": { "module": "dues", "siteId": "site_a", "suspension": "operational", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "suspended: financial-history read allowed", "tenant": { "status": "suspended" }, "request": { "module": "receivables", "permission": "invoice.view", "suspension": "history_read", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "suspended: history read still needs the permission", "tenant": { "status": "suspended" }, "permissions": [], "request": { "module": "receivables", "permission": "invoice.view", "suspension": "history_read", "at": "2026-10-26" }, "expect": "permission_missing" },
    { "name": "suspended: operational mutation blocked", "tenant": { "status": "suspended" }, "request": { "module": "dues", "siteId": "site_a", "suspension": "operational", "at": "2026-10-26" }, "expect": "tenant_suspended" },
    { "name": "suspended: undeclared action defaults to operational and is blocked", "tenant": { "status": "suspended" }, "request": { "module": "core", "at": "2026-10-26" }, "expect": "tenant_suspended" },
    { "name": "suspended: settlement allowed when the policy allows it (D-20)", "tenant": { "status": "suspended", "allowSettlement": true }, "request": { "module": "receivables", "permission": "finance.evidence.review", "suspension": "settlement", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "suspended: settlement blocked when the policy forbids it", "tenant": { "status": "suspended", "allowSettlement": false }, "request": { "module": "receivables", "permission": "finance.evidence.review", "suspension": "settlement", "at": "2026-10-26" }, "expect": "tenant_suspended" },
    { "name": "suspended: layer order, an ungranted module is reported as not licensed", "tenant": { "status": "suspended" }, "request": { "module": "crm", "suspension": "history_read", "at": "2026-10-26" }, "expect": "module_not_licensed" },
    { "name": "module never granted", "request": { "module": "crm", "permission": "lead.view", "at": "2026-10-26" }, "expect": "module_not_licensed" },
    { "name": "future-dated grant not yet in force", "request": { "module": "online_payments", "siteId": "site_a", "at": "2026-11-30" }, "expect": "module_not_licensed" },
    { "name": "future-dated grant in force from its start date", "request": { "module": "online_payments", "siteId": "site_a", "at": "2026-12-01" }, "expect": "allow" },
    { "name": "grant end date is exclusive", "request": { "module": "visitors", "at": "2026-11-01" }, "expect": "module_not_licensed" },
    { "name": "grant valid on the day before it ends", "request": { "module": "visitors", "at": "2026-10-31" }, "expect": "allow" },
    { "name": "site not included in a site-scoped grant", "request": { "module": "dues", "siteId": "site_b", "at": "2026-10-26" }, "expect": "site_not_licensed" },
    { "name": "site taken from the record when not given", "request": { "module": "dues", "record": { "siteId": "site_b" }, "at": "2026-10-26" }, "expect": "site_not_licensed" },
    { "name": "tenant-wide grant covers any site", "request": { "module": "receivables", "siteId": "site_b", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "feature granted", "request": { "module": "receivables", "feature": "receivables.office_collections", "at": "2026-10-26" }, "expect": "allow" },
    { "name": "feature not granted", "request": { "module": "dues", "siteId": "site_a", "feature": "dues.late_fees", "at": "2026-10-26" }, "expect": "feature_not_licensed" },
    { "name": "permission missing", "request": { "module": "receivables", "permission": "unit.hold", "at": "2026-10-26" }, "expect": "permission_missing" },
    { "name": "layer order: module before permission", "request": { "module": "crm", "permission": "unit.hold", "at": "2026-10-26" }, "expect": "module_not_licensed" },
    { "name": "site scope: record in another site is out of scope", "scopes": [{ "type": "site", "ids": ["site_a"] }], "request": { "module": "receivables", "record": { "siteId": "site_b" }, "at": "2026-10-26" }, "expect": "out_of_scope" },
    { "name": "site scope: record in the user's site", "scopes": [{ "type": "site", "ids": ["site_a"] }], "request": { "module": "receivables", "record": { "siteId": "site_a" }, "at": "2026-10-26" }, "expect": "allow" },
    { "name": "scope check is conservative: record without the scoped field", "scopes": [{ "type": "building", "ids": ["bld_a"] }], "request": { "module": "receivables", "record": { "siteId": "site_a" }, "at": "2026-10-26" }, "expect": "out_of_scope" },
    { "name": "legal-entity scope", "scopes": [{ "type": "legal_entity", "ids": ["le_assoc_a"] }], "request": { "module": "receivables", "record": { "legalEntityId": "le_assoc_b" }, "at": "2026-10-26" }, "expect": "out_of_scope" },
    { "name": "resident party scope: own verified unit", "scopes": [{ "type": "party", "partyId": "pty_a101", "units": ["unit_a101"], "billingAccounts": ["ba_a101"] }], "request": { "module": "receivables", "record": { "unitId": "unit_a101" }, "at": "2026-10-26" }, "expect": "allow" },
    { "name": "resident party scope: another flat", "scopes": [{ "type": "party", "partyId": "pty_a101", "units": ["unit_a101"], "billingAccounts": ["ba_a101"] }], "request": { "module": "receivables", "record": { "unitId": "unit_a102", "billingAccountId": "ba_a102" }, "at": "2026-10-26" }, "expect": "out_of_scope" },
    { "name": "resident party scope: liable billing account", "scopes": [{ "type": "party", "partyId": "pty_a102t", "units": [], "billingAccounts": ["ba_a102"] }], "request": { "module": "receivables", "record": { "billingAccountId": "ba_a102" }, "at": "2026-10-26" }, "expect": "allow" },
    { "name": "assigned scope: own record", "scopes": [{ "type": "assigned" }], "request": { "module": "core", "record": { "assignedTo": "usr_manager" }, "at": "2026-10-26" }, "expect": "allow" },
    { "name": "assigned scope: someone else's record", "scopes": [{ "type": "assigned" }], "request": { "module": "core", "record": { "assignedTo": "usr_other" }, "at": "2026-10-26" }, "expect": "out_of_scope" },
    { "name": "state locked (posted record)", "request": { "module": "receivables", "state": { "locked": true }, "at": "2026-10-26" }, "expect": "state_locked" },
    { "name": "maker cannot check own work", "request": { "module": "dues", "siteId": "site_a", "state": { "makerUserId": "usr_manager" }, "at": "2026-10-26" }, "expect": "separation_of_duties" },
    { "name": "a different user may check", "request": { "module": "dues", "siteId": "site_a", "state": { "makerUserId": "usr_treasurer" }, "at": "2026-10-26" }, "expect": "allow" }
  ]
}
